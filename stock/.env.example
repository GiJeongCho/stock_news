# 네이버 계정 (프리미엄콘텐츠 구독 계정)
NAVER_ID=your_naver_id
NAVER_PW=your_naver_pw
# 1: 스크립트가 아이디/비번 자동 입력, 0: 열린 Chrome 창에서 직접 로그인
AUTO_LOGIN=1

# 대상 채널
CHANNEL_URL=https://contents.premium.naver.com/insightstrader/insight

# 텔레그램 전송 대상 여러 개: "이름|봇토큰|chat_id" 를 쉼표로 구분 (각 수신자는 해당 봇에 /start 를 먼저 보내야 함)
TELEGRAM_TARGETS=홍길동|123456:ABC...|11111111, 김철수|654321:XYZ...|22222222

# TELEGRAM_TARGETS 가 비어 있을 때 쓰는 단일 대상. CHAT_ID 를 비우면 봇에 메시지를 보낸 사람을 자동 탐지
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=

# 동작
POLL_INTERVAL_SEC=3600       # 새 글 확인 주기(초) — 기본 1시간
SESSION_CHECK_SEC=1800       # 로그인 세션 확인 주기(초)
TODAY_ONLY=1
MAX_BACKFILL=20
SUMMARY_MAX_CHARS=2500       # 요약 본문 최대 길이(이하면 전문 전송)
DAILY_DIGEST_HOUR=           # 예: 18 → 매일 18시에 그날 글 목록 한 번 더 전송

# LLM 요약(선택). 키가 있으면 LLM 요약, 없으면 규칙 기반 요약
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 브라우저 (댓글 봇과 분리된 프로필/포트)
DEBUG_PORT=9223
CHROME_USER_DATA=.chrome-stock
