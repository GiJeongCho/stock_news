# 네이버 계정
NAVER_ID=your_naver_id
NAVER_PW=your_naver_pw
# 0: 열린 Chrome 창에서 직접 로그인(권장) / 1: 스크립트가 자동 입력
AUTO_LOGIN=0

# 대상 블로그 ID (blog.naver.com/<이 값>)
BLOG_ID=studiochoix

# 댓글을 달 글의 logNo. 비우면 "새 글 감지" 모드로 동작
POST_LOGNO=224426920489

# 댓글 내용 (여러 줄은 \n 으로 구분)
COMMENT_TEXT=홍길동 01012345678\n11일 일요일 오후 2시 픽업\n모듬과일 #파블로바

# 비밀댓글 체크 여부
SECRET_COMMENT=1

# 댓글이 열리는 목표 시각 (KST, 24h)
TARGET_HOUR=9
TARGET_MINUTE=0

# 폴링 간격(초): 10분 전까지 / 10분 전~1분 전 / 1분 전부터(페이지 로드 사이 추가 대기)
POLL_INTERVAL_IDLE=30
POLL_INTERVAL_NORMAL=5
POLL_INTERVAL_FAST=0.3
SESSION_REFRESH_SEC=600

# 브라우저: 디버깅 포트로 띄운 Chrome 에 붙어서 새 탭에서 작업
# Chrome 136+ 는 기본 User Data 폴더에서 원격 디버깅을 차단하므로 별도 폴더를 사용
ATTACH_MODE=1
DEBUG_PORT=9222
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_DEBUG_USER_DATA=.chrome-debug
CHROME_PROFILE_NAME=Default

# ATTACH_MODE=0 일 때 Selenium 이 직접 쓰는 고정 프로필
CHROME_USER_DATA_DIR=.chrome-profile
